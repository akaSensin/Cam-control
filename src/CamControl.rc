/*
	Cam Control - made by sensin
	Version / product metadata embedded in CamControl.asi.

	This is ordinary DLL hygiene: it lets Windows show who made the file in
	Properties > Details, and it gives antivirus scanners normal product identity
	to work with instead of an anonymous binary. It does not hide anything -
	every field below is also visible in the shipped README.
*/

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    0,4,0,0
 PRODUCTVERSION 0,4,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName",      "sensin"
			VALUE "FileDescription",  "Cam Control - GTA V camera control mod (ScriptHookV ASI plugin)"
			VALUE "FileVersion",      "0.4.0.0"
			VALUE "InternalName",     "CamControl"
			VALUE "LegalCopyright",   "made by sensin"
			VALUE "OriginalFilename", "CamControl.asi"
			VALUE "ProductName",      "Cam Control"
			VALUE "ProductVersion",   "0.4.0.0"
			VALUE "Comments",         "Offline single-player mod. Uses only the public ScriptHookV SDK."
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
